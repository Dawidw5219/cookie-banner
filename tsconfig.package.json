{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/api/native.ts",
    "src/vite-env.d.ts",
    "src/api/dev.ts"
  ],
  "exclude": [
    "**/*.test.*"
  ]
}
