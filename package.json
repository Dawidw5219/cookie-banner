{
  "name": "cookie-banner",
  "version": "2.0.0",
  "description": "Lightweight GDPR cookie consent banner with Google Consent Mode v2 support.",
  "type": "module",
  "main": "dist/cookie-banner.js",
  "files": [
    "dist",
    "README.md",
    "docs/consent-compliance.md",
    "docs/consent-integration.md",
    "docs/multilingual.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dawidw5219/cookie-banner.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run build:banner && bun run --cwd plugin build",
    "build:banner": "vite build && vite build --config vite.native.config.ts && tsc -p tsconfig.package.json && bun run scripts/package-metadata.ts",
    "deploy": "bun run build && ghdeploy --release 'plugin/builds/cookie-banner-wp-{version}.zip'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:all": "bun run build",
    "update:databases": "bun run scripts/update-service-databases.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "test:package": "node scripts/test-npm-package.mjs",
    "test:privacy": "node scripts/test-consent-hardening.mjs"
  },
  "dependencies": {
    "preact": "^10"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2",
    "@tailwindcss/vite": "^4",
    "jsdom": "^26.0.0",
    "playwright": "1.65.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.2"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "plugin"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild"
  ],
  "exports": {
    ".": "./dist/cookie-banner.js",
    "./auto": "./dist/cookie-banner.js",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    }
  }
}
