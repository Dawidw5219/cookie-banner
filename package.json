{
  "name": "@app4you/cookie-banner",
  "version": "3.0.0",
  "description": "Framework-independent cookie consent banner with Google Consent Mode v2 support.",
  "type": "module",
  "main": "./dist/native.js",
  "files": [
    "dist",
    "README.md",
    "docs/consent-integration.md",
    "docs/consent-compliance.md",
    "docs/multilingual.md",
    "docs/deployment-security.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dawidw5219/cookie-banner.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite example",
    "build": "bun run build:banner && bun run --cwd plugin build",
    "build:banner": "bun run typecheck && vite build && vite build --config vite.native.config.ts && tsc -p tsconfig.package.json && bun run scripts/package-metadata.ts",
    "deploy": "bun scripts/deploy.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:all": "bun run build",
    "update:databases": "bun run scripts/update-service-databases.ts",
    "test:browser": "node tests/browser/browser.mjs",
    "test:package": "node tests/package/npm-package.mjs",
    "test:privacy": "node tests/browser/consent-hardening.mjs",
    "test:accessibility": "node tests/browser/accessibility.mjs",
    "build:demo": "bun run typecheck && vite build example --base /cookie-banner/",
    "test:demo": "node tests/browser/demo.mjs"
  },
  "dependencies": {
    "preact": "^10"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2",
    "@tailwindcss/vite": "^4",
    "@types/node": "22.20.5",
    "axe-core": "^4.14.0",
    "jsdom": "^26.0.0",
    "playwright": "1.65.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.2"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "plugin"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild"
  ],
  "exports": {
    ".": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./auto": "./dist/cookie-banner.js",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "module": "./dist/native.js",
  "types": "./dist/native.d.ts"
}
